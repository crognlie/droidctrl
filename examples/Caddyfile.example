# Caddy reverse-proxy config for droidctrl over HTTPS.
#
# The droidctrl container must share a Docker network with Caddy so that
# `droidctrl:6080` resolves. See compose.override.yml / compose.yml for the
# network setup (default_bridge).
#
# URL prefix /droidctrl/ is used throughout. Change it consistently here and
# in any bookmarks; the container itself is prefix-agnostic.

yourhost.example.com {
    tls /path/to/cert.pem /path/to/key.pem

    # Redirect bare /droidctrl to /droidctrl/
    @droidctrl_bare path /droidctrl
    redir @droidctrl_bare /droidctrl/

    # Wheel-scroll swipe endpoint — routed to the sidecar port so it is
    # handled even while the main stream port is busy with video data.
    handle /droidctrl/swipe {
        rewrite * /swipe
        reverse_proxy droidctrl:6081
    }

    # Everything else: player page, WebSocket stream, tap/drag/key endpoints.
    handle_path /droidctrl/* {
        reverse_proxy droidctrl:6080
    }
}
