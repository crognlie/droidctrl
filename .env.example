# Copy to .env and fill in values for your setup.

# Container timezone
TZ=UTC

# Path to the host directory containing adbkey + adbkey.pub.
# Generate with: adb start-server (run once on the host).
# Default: ${HOME}/.android
ADB_KEY_DIR=

# Phone screen resolution override — optional. If unset, screenrecord captures
# at the phone's native resolution (the default and usually correct behavior).
# Only set these if you need to force a specific capture size.
# Check native size with: adb shell wm size
#SCREEN_WIDTH=1080
#SCREEN_HEIGHT=2400

# Host port to expose the stream player on.
PORT=6080

# USB vendor ID of the phone, used for USB wedge self-heal on startup.
# 18d1 = Google (Pixel). Others: 04e8 Samsung, 22b8 Motorola, 2a70 OnePlus.
USB_RESET_VID=18d1

# Set true to route the phone's internet through the host via gnirehtet.
REVERSE_TETHER=false

# Target ceiling bitrate for screenrecord. Actual rate is much lower for
# mostly-static content; this caps bursts during motion.
BIT_RATE=8M

# ---- automator sidecar (only needed with --profile automator) ----

# How often the automator polls the phone screen (seconds).
POLL_INTERVAL=10

# Host path to write game backups. Created automatically if missing.
BACKUP_DIR=/tmp/automator-backup
