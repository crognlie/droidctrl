# Copy to .env and fill in. All variables are optional unless noted.

# Public hostname used in the startup "ready" message (empty -> localhost)
NOVNC_HOST=

# Timezone for the container
TZ=UTC

# Absolute path to your host's .android directory (must contain adbkey + adbkey.pub,
# which are generated by running `adb start-server` once on the host).
# Empty -> ${HOME}/.android
ADB_KEY_DIR=

# Phone screen resolution in pixels. Check with: adb shell wm size
SCREEN_WIDTH=1080
SCREEN_HEIGHT=2400

# Host port to expose noVNC on
NOVNC_PORT=6080
